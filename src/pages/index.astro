---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectHeader from '../components/ProjectHeader.astro';
import Illustration from '../components/Illustration.astro';
import { PROJECTS } from '../data/projects';
import portrait from '../assets/portrait.jpg';

const linkClass =
  'underline decoration-slate-700/20 decoration-[1.5px] underline-offset-[3px] transition-colors duration-200 hover:decoration-slate-700/40';
---

<Layout themeColor="#f8f8f8">
  <div class="mx-4 mt-24 max-w-5xl pb-48 sm:mx-[10vw] lg:mx-[14vw] lg:mt-48 lg:text-lg">
    <div class="max-w-3xl px-4 font-medium text-slate-900/90 lg:px-8">
      <Image
        class="mb-6 block h-24 w-24 rounded-full border border-white/30 shadow-xs"
        src={portrait}
        width={96}
        height={96}
        densities={[1, 2]}
        alt="Portrait of Martin Klepsch"
        loading="eager"
      />
      <p class="my-2">I'm Martin, a product engineer and curious mind, looking for my next adventure.</p>
      <p class="my-2">Below you can find a small tour of things I worked on recently.</p>
    </div>

    <div class="mt-16 space-y-8 text-white/90">
      {
        PROJECTS.map((project) => (
          <a href={`/${project.slug}`} class="block">
            <div
              class:list={['relative h-80 overflow-hidden rounded-2xl p-4 lg:p-8', project.bg]}
              style={`view-transition-name: backdrop-${project.slug}`}
            >
              <ProjectHeader project={project} />
              <Illustration slug={project.slug} />
            </div>
          </a>
        ))
      }
    </div>

    <div class="my-16 flex items-center justify-center gap-4 font-medium text-slate-900/90">
      <a class={linkClass} href="mailto:martinklepsch@gmail.com">Email</a>
      <a class={linkClass} href="https://github.com/martinklepsch">GitHub</a>
      <a class={linkClass} href="https://x.com/martinklepsch">X</a>
      <a class={linkClass} href="https://read.cv/martinklepsch">Read.cv</a>
    </div>
  </div>
</Layout>
